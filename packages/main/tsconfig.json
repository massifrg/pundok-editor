{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "sourceMap": false,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "isolatedModules": true,
    "types": ["node"],
    "ignoreDeprecations": "6.0",
    "baseUrl": "."
  },
  "include": [
    "src/**/*.ts",
    "../../types/**/*.d.ts",
    "../backend/src/expandCommandArgs.ts",
    "../backend/src/documentHash.ts"
  ],
  "exclude": ["**/*.spec.ts", "**/*.test.ts"]
}
